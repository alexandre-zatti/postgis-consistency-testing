sercontent.com/u/289678?v=4","gravatar_id":"","url":"https://api.github.com/users/strk","html_url":"https://github.com/strk","followers_url":"https://api.github.com/users/strk/followers","following_url":"https://api.github.com/users/strk/following{/other_user}","gists_url":"https://api.github.com/users/strk/gists{/gist_id}","starred_url":"https://api.github.com/users/strk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/strk/subscriptions","organizations_url":"https://api.github.com/users/strk/orgs","repos_url":"https://api.github.com/users/strk/repos","events_url":"https://api.github.com/users/strk/events{/privacy}","received_events_url":"https://api.github.com/users/strk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-25T08:29:11Z","updated_at":"2026-09-25T08:29:11Z","body":"@dbaston ST_Crosses returns false too, btw:\n```\ngeosop -a 0102000020A2100000030000005163B45884333540352259FDE66A51406043FEC3BA333540C0BFF081E66A5140831D215B88333540107B41F4E66A5140 -b 0102000020A210000002000000685E205B88333540B7363CF4E66A5140831D215B88333540107B41F4E66A5140 crosses\nfalse\n```","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/libgeos/geos/issues/comments/5829363848/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/libgeos/geos/issues/comments/5874098891","html_url":"https://github.com/libgeos/geos/issues/1530#issuecomment-5874098891","issue_url":"https://api.github.com/repos/libgeos/geos/issues/1530","id":5874098891,"node_id":"IC_kwDOACh1KM8AAAABXh-iyw","user":{"login":"strk","id":289678,"node_id":"MDQ6VXNlcjI4OTY3OA==","avatar_url":"https://avatars.githubusercontent.com/u/289678?v=4","gravatar_id":"","url":"https://api.github.com/users/strk","html_url":"https://github.com/strk","followers_url":"https://api.github.com/users/strk/followers","following_url":"https://api.github.com/users/strk/following{/other_user}","gists_url":"https://api.github.com/users/strk/gists{/gist_id}","starred_url":"https://api.github.com/users/strk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/strk/subscriptions","organizations_url":"https://api.github.com/users/strk/orgs","repos_url":"https://api.github.com/users/strk/repos","events_url":"https://api.github.com/users/strk/events{/privacy}","received_events_url":"https://api.github.com/users/strk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-28T16:20:23Z","updated_at":"2026-09-28T16:20:23Z","body":"JTS gives the same probematic output. Filed upstream: https://github.com/locationtech/jts/issues/1236","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/libgeos/geos/issues/comments/5874098891/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/libgeos/geos/issues/comments/5876928771","html_url":"https://github.com/libgeos/geos/issues/1530#issuecomment-5876928771","issue_url":"https://api.github.com/repos/libgeos/geos/issues/1530","id":5876928771,"node_id":"IC_kwDOACh1KM8AAAABXkrRAw","user":{"login":"dr-jts","id":3529053,"node_id":"MDQ6VXNlcjM1MjkwNTM=","avatar_url":"https://avatars.githubusercontent.com/u/3529053?v=4","gravatar_id":"","url":"https://api.github.com/users/dr-jts","html_url":"https://github.com/dr-jts","followers_url":"https://api.github.com/users/dr-jts/followers","following_url":"https://api.github.com/users/dr-jts/following{/other_user}","gists_url":"https://api.github.com/users/dr-jts/gists{/gist_id}","starred_url":"https://api.github.com/users/dr-jts/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dr-jts/subscriptions","organizations_url":"https://api.github.com/users/dr-jts/orgs","repos_url":"https://api.github.com/users/dr-jts/repos","events_url":"https://api.github.com/users/dr-jts/events{/privacy}","received_events_url":"https://api.github.com/users/dr-jts/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-28T19:26:09Z","updated_at":"2026-09-28T19:28:57Z","body":"> So we either have a bug in LineMerger OR we have it in RelateOp.\n> what's your take ?\n\nThe simple answer is that `LineMerger` is acting as designed, and the result is expected.  It just joins lines at common endpoints.  If the input lines cross, the output will be non-simple.  This example makes it obvious:\n```\nA: MULTILINESTRING ((1 5, 9 5, 2 8), (2 2, 2 8))\nResult: LINESTRING (1 5, 9 5, 2 8, 2 2)\n```\n<img width=\"394\" height=\"186\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/c0853ae3-c7d8-4d10-b6aa-18a69a48399e\" />\n\nThe real question is why does `IsSimpleOp` report the result as non-simple, while `RelateOp` does not report an Interior-Interior intersection (i.e. they are inconsistent).  This is a limitation in `RelateOp`.  Because the intersection of the short segment B with A lies so close to a vertex of A, the intersection point is computed as being **equal** to an endpoint of B.  For better or worse, RelateOp uses the computed value of intersections to determine the Intersection Matrix.  \n\nHowever, IsSimpleOp just checks the intersects predicate for line segments.  The intersects predicate is more precise than the intersection computation (because it just needs to report T/F, rather than return a numerical result). So the line crossing is detected and reported.\n\nThe `RelateOp` reliance on computed intersections is done to avoid other kinds of inconsistencies.  It would take some research to see if it could be improved for cases like this without impacting other situations.\n\n@strk given this is **not** an issue with LineMerger, this ticket should be closed.  If you want you could open another ticket about the undesirable RelateOp result. \n\nAlso, the LineMerger documentation is a bit unclear about how crossing lines are handled.  I will improve that in JTS.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/libgeos/geos/issues/comments/5876928771/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/libgeos/geos/issues/comments/5888347070","html_url":"https://github.com/libgeos/geos/issues/1530#issuecomment-5888347070","issue_url":"https://api.github.com/repos/libgeos/geos/issues/1530","id":5888347070,"node_id":"IC_kwDOACh1KM8AAAABXvkLvg","user":{"login":"strk","id":289678,"node_id":"MDQ6VXNlcjI4OTY3OA==","avatar_url":"https://avatars.githubusercontent.com/u/289678?v=4","gravatar_id":"","url":"https://api.github.com/users/strk","html_url":"https://github.com/strk","followers_url":"https://api.github.com/users/strk/followers","following_url":"https://api.github.com/users/strk/following{/other_user}","gists_url":"https://api.github.com/users/strk/gists{/gist_id}","starred_url":"https://api.github.com/users/strk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/strk/subscriptions","organizations_url":"https://api.github.com/users/strk/orgs","repos_url":"https://api.github.com/users/strk/repos","events_url":"https://api.github.com/users/strk/events{/privacy}","received_events_url":"https://api.github.com/users/strk/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-29T10:26:09Z","updated_at":"2026-09-29T10:26:09Z","body":"Closing in favour of the bogus-RelateOp report: GH-1540","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/libgeos/geos/issues/comments/5888347070/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]